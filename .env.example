# claudebot-gateway environment variables
# Copy this file to .env and fill in values as needed.

# --- Claude Agent SDK ---
# The Claude Agent SDK reads ANTHROPIC_API_KEY automatically.
# See: https://docs.anthropic.com/en/docs/claude-code/sdk
ANTHROPIC_API_KEY=

# --- Telegram Channel ---
# Used by TelegramChannel if bot_token is not set in config.json.
# CLAUDEBOT_TELEGRAM_BOT_TOKEN takes precedence over TELEGRAM_BOT_TOKEN.
CLAUDEBOT_TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
